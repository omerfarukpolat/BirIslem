{
  "name": "bir-islem",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bir İşlem - Matematik Zeka Oyunu. 5 küçük sayı ve 1 büyük sayı ile hedef sayıya ulaşmaya çalışın.",
  "keywords": [
    "matematik",
    "zeka oyunu",
    "bir işlem",
    "sayı oyunu",
    "matematik oyunu"
  ],
  "author": "Bir İşlem",
  "homepage": "https://www.birislem.app",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-birislem"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "firebase": "^12.19.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
